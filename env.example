# ─────────────────────────────────────────────────────────────
# .env — Konfigurasi koneksi database
# JANGAN commit file ini ke GitHub — sudah ada di .gitignore
# ─────────────────────────────────────────────────────────────

# Path ke file data raw SYNOP
RAW_FILE_PATH=RAW_SYNOP_REPORT.csv

# Supabase PostgreSQL — ambil dari Settings > Database di dashboard Supabase
DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_database_password
